<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <StartupObject>DVault.Tests.Modeling.DefaultNamingPolicyTests</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <DVaultTestProject Include="Unit/DVault.Tests.Unit.csproj" />
    <DVaultTestProject Include="Integration/DVault.Tests.Integration.csproj" />
    <DVaultTestAssembly Include="$(MSBuildThisFileDirectory)../../bin/DVault.Tests.Unit/$(Configuration)/$(TargetFramework)/DVault.Tests.Unit.dll" />
    <DVaultTestAssembly Include="$(MSBuildThisFileDirectory)../../bin/DVault.Tests.Integration/$(Configuration)/$(TargetFramework)/DVault.Tests.Integration.dll" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Integration\**\*.cs" />
    <Compile Remove="Shared\**\*.cs" />
    <Compile Remove="Unit\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Integration\**\*.cs" />
    <Compile Remove="Shared\**\*.cs" />
    <Compile Remove="Unit\**\*.cs" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Target Name="BuildDVaultTestProjects" AfterTargets="Build">
    <Exec
      Command="dotnet restore &quot;%(DVaultTestProject.Identity)&quot; --nologo"
      EnvironmentVariables="DOTNET_CLI_TELEMETRY_OPTOUT=1;TESTINGPLATFORM_TELEMETRY_OPTOUT=1" />
    <Exec
      Command="dotnet build &quot;%(DVaultTestProject.Identity)&quot; --configuration &quot;$(Configuration)&quot; --no-restore --nologo"
      EnvironmentVariables="DOTNET_CLI_TELEMETRY_OPTOUT=1;TESTINGPLATFORM_TELEMETRY_OPTOUT=1" />
  </Target>

  <Target Name="VSTest" DependsOnTargets="Build">
    <Message Text="Running DVault executable tests" Importance="high" />
    <Exec
      Command="dotnet &quot;%(DVaultTestAssembly.Identity)&quot;"
      EnvironmentVariables="DOTNET_CLI_TELEMETRY_OPTOUT=1;TESTINGPLATFORM_TELEMETRY_OPTOUT=1" />
  </Target>
</Project>
