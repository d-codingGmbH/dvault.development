<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RunAnalyzers>true</RunAnalyzers>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="BenchmarkScenarioExecutionTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.28" />
    <PackageReference Include="IBM.EntityFrameworkCore" Version="8.0.0.400" Condition="'$(DVAULT_TEST_DB2_CONNECTION_STRING)' != ''" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="8.0.26" Condition="'$(DVAULT_TEST_MYSQL_CONNECTION_STRING)' != ''" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" Condition="'$(DVAULT_TEST_POSTGRES_CONNECTION_STRING)' != ''" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.26200" Condition="'$(DVAULT_TEST_ORACLE_CONNECTION_STRING)' != ''" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.28" Condition="'$(DVAULT_TEST_SQLSERVER_CONNECTION_STRING)' != ''" />
    <PackageReference Include="xunit.v3.mtp-v1" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="IBM.EntityFrameworkCore" Version="10.0.0.100" Condition="'$(DVAULT_TEST_DB2_CONNECTION_STRING)' != ''" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.7" Condition="'$(DVAULT_TEST_MYSQL_CONNECTION_STRING)' != ''" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" Condition="'$(DVAULT_TEST_POSTGRES_CONNECTION_STRING)' != ''" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26200" Condition="'$(DVAULT_TEST_ORACLE_CONNECTION_STRING)' != ''" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" Condition="'$(DVAULT_TEST_SQLSERVER_CONNECTION_STRING)' != ''" />
    <PackageReference Include="xunit.v3.mtp-v1" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Snapshots/SqliteDataVaultSchemaSnapshot.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../benchmarks/DCoding.Data.DVault.Benchmarks/DCoding.Data.DVault.Benchmarks.csproj" Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="../../../src/DCoding.Data.DVault/DCoding.Data.DVault.csproj" />
    <ProjectReference Include="../../../src/DCoding.Data.DVault.Analyzers/DCoding.Data.DVault.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../../src/DCoding.Data.DVault.Db2/DCoding.Data.DVault.Db2.csproj" Condition="'$(DVAULT_TEST_DB2_CONNECTION_STRING)' != ''" />
    <ProjectReference Include="../../../src/DCoding.Data.DVault.MySql/DCoding.Data.DVault.MySql.csproj" />
    <ProjectReference Include="../../../src/DCoding.Data.DVault.Oracle/DCoding.Data.DVault.Oracle.csproj" />
    <ProjectReference Include="../../../src/DCoding.Data.DVault.Postgres/DCoding.Data.DVault.Postgres.csproj" />
    <ProjectReference Include="../../../src/DCoding.Data.DVault.SqlServer/DCoding.Data.DVault.SqlServer.csproj" />
    <ProjectReference Include="../../../src/DCoding.Data.DVault.Sqlite/DCoding.Data.DVault.Sqlite.csproj" />
    <ProjectReference Include="../Shared/DCoding.Data.DVault.Tests.Shared.csproj" />
  </ItemGroup>
</Project>
