<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>DCoding.Data.DVault.Analyzers</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PackageId>DCoding.Data.DVault.Analyzers</PackageId>
    <Title>DVault Roslyn Analyzers</Title>
    <Authors>d-coding GmbH</Authors>
    <Description>Roslyn analyzers and source generators for high-confidence DVault compile-time metadata declarations.</Description>
    <PackageTags>dvault;data-vault;roslyn;analyzer;source-generator;diagnostics;ef-core</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/d-codingGmbH/dvault.development.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/packages/</PackageOutputPath>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddAnalyzerPackageAssets</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DCoding.Data.DVault.Tests.Analyzers" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="System.Composition.AttributedModel" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="System.Composition.Hosting" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="System.Composition.Runtime" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="System.Composition.TypedParts" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="AddAnalyzerPackageAssets">
    <ItemGroup>
      <_AnalyzerPackageDependency Include="$(TargetDir)Microsoft.CodeAnalysis.CSharp.Workspaces.dll" />
      <_AnalyzerPackageDependency Include="$(TargetDir)Microsoft.CodeAnalysis.Workspaces.dll" />
      <_AnalyzerPackageDependency Include="$(TargetDir)System.Composition.AttributedModel.dll" />
      <_AnalyzerPackageDependency Include="$(TargetDir)System.Composition.Hosting.dll" />
      <_AnalyzerPackageDependency Include="$(TargetDir)System.Composition.Runtime.dll" />
      <_AnalyzerPackageDependency Include="$(TargetDir)System.Composition.TypedParts.dll" />
      <_AnalyzerPackageDependency Include="$(TargetDir)System.Text.Json.dll" />
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs/" />
      <TfmSpecificPackageFile Include="$(TargetDir)$(AssemblyName).xml" PackagePath="analyzers/dotnet/cs/" Condition="Exists('$(TargetDir)$(AssemblyName).xml')" />
      <TfmSpecificPackageFile Include="@(_AnalyzerPackageDependency)" PackagePath="analyzers/dotnet/cs/" Condition="Exists('%(Identity)')" />
    </ItemGroup>
  </Target>
</Project>
