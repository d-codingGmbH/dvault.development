<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DCoding.Data.DVault.Benchmarks</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" Condition="'$(DVAULT_TEST_POSTGRES_CONNECTION_STRING)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DCoding.Data.DVault/DCoding.Data.DVault.csproj" />
    <ProjectReference Include="../../src/DCoding.Data.DVault.Postgres/DCoding.Data.DVault.Postgres.csproj" />
    <ProjectReference Include="../../src/DCoding.Data.DVault.Sqlite/DCoding.Data.DVault.Sqlite.csproj" />
  </ItemGroup>
</Project>
