<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <DVaultBuildProject Include="tests\DVault.Tests\DVault.Tests.csproj" />
  </ItemGroup>

  <Target Name="Restore">
    <MSBuild
      Projects="@(DVaultBuildProject)"
      Targets="Restore"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="Build" DependsOnTargets="Restore">
    <MSBuild
      Projects="@(DVaultBuildProject)"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="VSTest" DependsOnTargets="Build">
    <MSBuild
      Projects="@(DVaultBuildProject)"
      Targets="VSTest"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="Clean">
    <MSBuild
      Projects="@(DVaultBuildProject)"
      Targets="Clean"
      Properties="Configuration=$(Configuration)" />
  </Target>
</Project>