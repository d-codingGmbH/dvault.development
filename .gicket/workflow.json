{
  "$schema": "https://schemas.d-coding.de/gicket/workflow/v1",
  "defaults": {
    "rules": [
      {
        "effect": "allow",
        "from": "todo",
        "to": "doing"
      },
      {
        "effect": "allow",
        "from": "doing",
        "to": "done"
      },
      {
        "effect": "allow",
        "from": "todo",
        "to": "ready-for-integration"
      },
      {
        "effect": "allow",
        "from": "ready-for-integration",
        "to": "done"
      },
      {
        "effect": "allow",
        "from": "ready-for-integration",
        "to": "todo"
      },
      {
        "effect": "allow",
        "from": "done",
        "to": "doing"
      },
      {
        "effect": "allow",
        "from": "doing",
        "to": "todo"
      }
    ]
  },
  "ticket-types": {
    "epic": {
      "rules": [
        {
          "effect": "allow",
          "from": "todo",
          "to": "done",
          "description": "Allow closure-only tracking epics to close after PO-critic audit."
        }
      ]
    }
  }
}
